# Template for the `expenses-tracker-secrets` Secret.
#
# This Secret is NOT managed by kustomize — it is created out-of-band so real
# credentials never land in git. All three workloads (backend, postgres, redis)
# consume it wholesale via `envFrom.secretRef`.
#
# Copy to secrets.env (gitignored), fill in, then run the create command in
# k8s/README.md.
#
# The backend maps these onto its Hoplite config by lowercasing and turning
# `_` into `.` (see backend/src/main/kotlin/config/Configuration.kt):
#   POSTGRES_JDBC_URL -> postgres.jdbc.url
#   OAUTH_CLIENT_ID   -> oauth.client.id

# --- postgres: consumed by both the postgres container and the backend ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# In-cluster host is the Service name from base/postgres/service.yaml:
#   jdbc:postgresql://expenses-tracker-database:5432/<POSTGRES_DB>
POSTGRES_JDBC_URL=

# --- redis: REDIS_PASSWORD is also interpolated into the redis args ---
REDIS_PASSWORD=
# In-cluster host is the Service name from base/redis/service.yaml
REDIS_HOSTNAME=expenses-tracker-redis
REDIS_PORT=6379

# --- oauth ---
OAUTH_PROVIDER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=

# --- app ---
AES_KEY=
ADMIN_PASSWORD=
